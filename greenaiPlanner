# ===============================================================
# TRAIN ML MODEL FOR 10 CROPS
# ===============================================================
def train_crop_model():
    data = {
        'N':      [90, 120, 50, 75, 55, 60, 40, 80, 65, 85],
        'P':      [40, 55, 22, 30, 25, 30, 20, 35, 28, 32],
        'K':      [38, 45, 18, 25, 20, 25, 15, 30, 35, 40],
        'temp':   [26, 29, 34, 30, 20, 28, 32, 27, 30, 33],
        'humidity':[80, 65, 92, 70, 75, 60, 85, 78, 68, 72],
        'ph':     [6.5, 7.0, 5.8, 6.3, 5.5, 6.0, 6.2, 6.8, 6.4, 7.2],
        'crop': [
            'rice', 'wheat', 'maize', 'sugarcane',
            'potato', 'tomato', 'groundnut', 'banana',
            'coconut', 'cotton'
        ]
    }

    df = pd.DataFrame(data)
    X = df[['N', 'P', 'K', 'temp', 'humidity', 'ph']].values
    y = pd.get_dummies(df['crop']).values

    model = Sequential([
        Dense(12, activation='relu', input_dim=6),
        Dense(10, activation='relu'),
        Dense(y.shape[1], activation='softmax')
    ])

    model.compile(optimizer='adam', loss='categorical_crossentropy')
    model.fit(X, y, epochs=60, verbose=0)

    return model, df


model, df = train_crop_model()


# ===============================================================
# Predict crop
# ===============================================================
def predict_crop(N, P, K, temp, humidity, ph):
    X_test = np.array([[N, P, K, temp, humidity, ph]])
    pred = model.predict(X_test)
    crop_list = df['crop'].unique()
    return crop_list[np.argmax(pred)]


# ===============================================================
# Weather API
# ===============================================================
def get_weather(city):
    url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={WEATHER_API_KEY}&units=metric"
    try:
        data = requests.get(url, timeout=10).json()
    except:
        return None, None

    if "main" not in data:
        return None, None

    return data["main"]["temp"], data["main"]["humidity"]


# ===============================================================
# Fertilizer calculator
# ===============================================================
def calculate_fertilizer(n_required, p_required, k_required):
    urea = n_required / 0.46
    dap = p_required / 0.46
    mop = k_required / 0.60
    return round(urea, 2), round(dap, 2), round(mop, 2)


